# Copy this file to backend/.env and fill in the values.
# backend/.env is gitignored and must never be committed.
#
# In a deployment these are set as environment variables on the host instead of
# in a file. Real environment variables take priority over backend/.env, so the
# same code runs in both places without being edited.

# SQLAlchemy connection string for the MySQL database.
# A managed provider usually hands out a plain mysql:// URL. That is fine, the
# app rewrites the scheme to mysql+pymysql:// at start up.
DATABASE_URL=

# Long random string used to sign JWT access tokens.
# Generate a fresh one for the deployment, do not reuse the local value.
JWT_SECRET=

# Optional. Left commented out because the defaults below are the values used
# unless you uncomment these and set your own.
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database TLS.
#   auto     the default, negotiate TLS and carry on if the server has none
#   require  insist on TLS and verify the certificate, fail if unavailable
#   disable  never use TLS
# DB_SSL=auto
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Browser origins allowed to call the API, comma separated. Only needed when
# the frontend is served from somewhere other than this app, such as the Vite
# dev server. Same origin requests do not use CORS at all.
# CORS_ORIGINS=http://localhost:5173

# Where the built React app lives. The Dockerfile puts it where the default
# already looks, so this normally stays unset.
# FRONTEND_DIST=

# Port for uvicorn to bind. The host usually injects this.
# PORT=8000

# Folder containing the trained DistilBERT subcategory classifier.
# Leave unset to run the matcher in fallback mode, which needs no torch.
# CLASSIFIER_MODEL_PATH=C:\path\to\cv_classifier_model

# Only set this if the taxonomy is moved from ml/skills/skills_taxonomy.json
# SKILLS_TAXONOMY_PATH=
